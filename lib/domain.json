  "actions": {
    "deployment_regression": [
      "Validate the failing version with a canary; prepare a rollback to the last healthy release.",
      "Compare error rate by version and verify recovery before restoring traffic."
    ],
    "connection_pool_exhaustion": [
      "Inspect active and idle connections and pool limits; drain stuck consumers before a controlled pool adjustment.",
      "Verify database headroom and falling connection wait time; do not raise limits blindly."
    ],
    "memory_leak": [
      "Capture a heap profile and compare retained allocations; recycle affected instances gradually if needed.",
      "Verify stable memory after warm-up and no further OOM events."
    ],
    "dependency_outage": [
      "Confirm the downstream service health; consider a circuit breaker or tested fallback to reduce cascading failures.",
      "Verify dependency availability and end-to-end success before removing mitigations."
    ],
    "traffic_saturation": [
      "Check capacity and demand; apply tested rate limits or scale consumers within downstream capacity.",
      "Verify queue depth, CPU and tail latency return to baseline."
    ],
    "config_error": [
      "Validate the changed configuration against the last known working version; prepare a scoped revert.",
      "Verify validation passes and affected requests recover after the change."
    ],
    "network_failure": [
      "Check DNS resolution and packet loss from affected hosts; engage the network owner with probe evidence.",
      "Verify resolution, connectivity and end-to-end latency from multiple affected hosts."
    ],
    "disk_exhaustion": [
      "Inspect disk and inode usage; rotate expendable logs or expand the volume using an approved runbook.",
      "Verify free space and successful writes; preserve evidence before cleanup."
    ]
  }
}